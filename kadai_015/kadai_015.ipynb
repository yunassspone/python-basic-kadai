      "source": [
        "class Human:\n",
        "  def _init_(self):\n",
        "    self.name = \"\"\n",
        "    self.age = \"\"\n",
        "\n",
        "  def printinfo(self, name, age):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "    print(self.name)\n",
        "    print(self.age)\n",
        "\n",
        "human = Human()\n",
        "human.printinfo(\"山田太郎\", 20)\n"
      ]
    }
  ]
